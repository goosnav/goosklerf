*.psd
*.psb

# Common image formats
*.jpg
*.jpeg
*.png
*.gif
*.tiff
*.bmp
*.svg

# Keep checked-in source/reference assets.
!rulebook/reference/**/*.jpg
!rulebook/reference/**/*.jpeg
!rulebook/reference/**/*.png
!rulebook/reference/**/*.gif
!rulebook/reference/**/*.svg
!rulebook/reference/**/*.pdf

